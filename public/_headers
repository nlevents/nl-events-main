# ---------------------------------------------------------------------------
# Security headers (no Cache-Control here, so the caching rules below are untouched).
# The two double-underscore NLE placeholders inside the CSP line are filled in at
# build time by the "nle-csp" plugin in vite.config.js (it hashes the inline
# scripts of index.html and adds your Supabase origin). The build fails if any
# placeholder is left over.
# ---------------------------------------------------------------------------
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' __NLE_SCRIPT_HASHES__ https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' blob: https:; frame-src https://www.youtube-nocookie.com https://www.youtube.com https://www.openstreetmap.org; connect-src 'self' __NLE_SUPABASE_ORIGIN__ https://api.cloudinary.com https://res.cloudinary.com https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://stats.g.doubleclick.net; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Vite content-hashes everything in /assets, so those files never change and
# can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Everything else (index.html and the SPA routes that resolve to it) uses
# Netlify's default "public, max-age=0, must-revalidate": the browser always
# revalidates the HTML shell, so it can never keep pointing at deleted chunk
# filenames, but it still gets cheap 304s and the back/forward cache keeps
# working on mobile.
#
# Do NOT add a blanket "/*" Cache-Control here. Netlify merges matching rules,
# so a "/*" no-cache/no-store line is combined with the /assets/* line above
# instead of being overridden by it, and "no-store" also disables the browser's
# back/forward cache.
