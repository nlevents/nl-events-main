# Vite content-hashes everything in /assets, so those files never change and
# can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Everything else (index.html and the SPA routes that resolve to it) uses
# Netlify's default "public, max-age=0, must-revalidate": the browser always
# revalidates the HTML shell, so it can never keep pointing at deleted chunk
# filenames, but it still gets cheap 304s and the back/forward cache keeps
# working on mobile.
#
# Do NOT add a blanket "/*" Cache-Control here. Netlify merges matching rules,
# so a "/*" no-cache/no-store line is combined with the /assets/* line above
# instead of being overridden by it, and "no-store" also disables the browser's
# back/forward cache.
