# The SPA fallback serves index.html for every React Router URL. Do not let a
# phone keep an old HTML shell that points at deleted Vite chunk filenames.
/*
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# Vite asset filenames are content-hashed, so these files are safe to cache.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
